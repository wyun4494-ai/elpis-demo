{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "vueCompilerOptions": {
    "target": 3
  },
  "include": [
    "app/**/*",
    "config/**/*",
    "model/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}